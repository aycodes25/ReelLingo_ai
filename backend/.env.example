# ---------- Core ----------
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=
STORAGE_BUCKET=reellingo-videos
PORT=8000
# Public URL of this API (used for OAuth callbacks and local signed file links)
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# The separate admin website (ReelLingo_Admin repo)
ADMIN_URL=http://localhost:3001
# Long random string: signs file links and OAuth state, encrypts integration tokens
APP_SECRET=
MOCK_MODE=true
LOG_LEVEL=info
# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# ---------- AI providers ----------
OPENAI_API_KEY=
# OPTIONAL — lets Admin → API usage show what OpenAI actually billed you (OpenAI has no "credit left" API).
#   1) Sign in at https://platform.openai.com as the organization Owner.
#   2) Settings (gear icon) → Organization → Admin keys → Create new admin key → copy it (starts with sk-admin-).
#   This is a DIFFERENT key from OPENAI_API_KEY above. Keep it private; it can read your organization's billing.
OPENAI_ADMIN_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_FALLBACK_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Distinct stock voices for extra speakers when they can't be cloned
ELEVENLABS_STOCK_VOICES=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# openai (Whisper) or elevenlabs (Scribe; multi-speaker jobs always use Scribe)
TRANSCRIPTION_PROVIDER=openai
# Background music/effects separation: auto | demucs | elevenlabs | ffmpeg | none
SEPARATION_PROVIDER=auto
DEMUCS_COMMAND=demucs
BACKGROUND_VOLUME=1

# ---------- Limits ----------
# Optional overrides for the free plan (otherwise the plans table decides)
FREE_VIDEOS_PER_MONTH=
FREE_MAX_VIDEO_MINUTES=
MAX_VIDEO_MINUTES=60
RETENTION_DAYS=30
MAX_REDUBS=5

# ---------- Worker ----------
# inline = process jobs inside the API; off = run `npm run worker` separately
WORKER_MODE=inline
WORKER_CONCURRENCY=2

# ---------- Security ----------
RATE_LIMIT_PER_15_MIN=600
AUTH_RATE_LIMIT_PER_15_MIN=30
JOB_RATE_LIMIT_PER_HOUR=30
# ClamAV clamd for upload virus scanning (docker compose --profile security up)
CLAMAV_HOST=
CLAMAV_PORT=3310
SENTRY_DSN=

# ---------- Import from link ----------
YTDLP_PATH=yt-dlp

# ---------- Notifications ----------
RESEND_API_KEY=
EMAIL_FROM=ReelLingo <notifications@yourdomain.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with two body variables: {{1}} message, {{2}} link
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------- Payments ----------
PAYSTACK_SECRET_KEY=
# Optional Paystack plan codes for automatic monthly renewal
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_CREATOR=
PAYSTACK_PLAN_STUDIO=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe price IDs (otherwise prices come from the plans table)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
NGN_PER_USD=1600

# ---------- Growth ----------
REFERRAL_BONUS_VIDEOS=1
REFERRAL_BONUS_MINUTES=10

# ---------- Lip-sync (sync.so) ----------
SYNC_API_KEY=
SYNC_MODEL=lipsync-2

# ---------- YouTube publishing (Google Cloud OAuth client) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Watermark / captions ----------
WATERMARK_TEXT=Made with ReelLingo
WATERMARK_FONT=
CAPTION_FONT=
