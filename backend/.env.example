# ---------- Core ----------
DATABASE_URL=
DATABASE_SSL=true
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=
STORAGE_BUCKET=reellingo-videos

# ---------------------------------------------------------------------
# VIDEO STORAGE: CLOUDFLARE R2 (free tier: 10 GB storage, free downloads)
# ---------------------------------------------------------------------
# Set up (about 10 minutes):
#   1) Sign up / log in at https://dash.cloudflare.com
#   2) Left menu → R2 Object Storage → "Purchase R2 plan"/"Enable R2" (choose the free plan; Cloudflare may ask for a card,
#      but you're only charged above the free 10 GB).
#   3) Create bucket → name it  reellingo-videos  → Location: Automatic → Default storage class: Standard → Create.
#   4) Open the bucket → Settings → CORS policy → Add CORS policy → paste this and save:
#        [{"AllowedOrigins":["http://localhost:3000","http://localhost:3001"],"AllowedMethods":["GET","HEAD"],
#          "AllowedHeaders":["*"],"ExposeHeaders":["Content-Length","Content-Range","Content-Disposition"],"MaxAgeSeconds":3600}]
#      (When you go live, add your real website and admin addresses to AllowedOrigins.)
#      Keep "Public access" OFF — ReelLingo uses private links that expire.
#   5) Back on the R2 Object Storage overview page, copy your "Account ID" into R2_ACCOUNT_ID.
#   6) R2 overview → "Manage API tokens" (or "API Tokens") → Create API token:
#        Permissions: Object Read & Write · Specify bucket: reellingo-videos · TTL: Forever → Create.
#      Copy "Access Key ID" into R2_ACCESS_KEY_ID and "Secret Access Key" into R2_SECRET_ACCESS_KEY.
#      The secret is shown only once — paste it straight away.
#   7) Set STORAGE_PROVIDER=r2 below and restart (npm run dev).
#   8) Copy your existing Supabase videos into R2 (only reads Supabase, never deletes):  npm --prefix backend run storage:copy-to-r2
# Leave STORAGE_PROVIDER empty to keep using Supabase Storage.
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reellingo-videos
PORT=8000
# Public URL of this API (used for OAuth callbacks and local signed file links)
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# The separate admin website (ReelLingo_Admin repo)
ADMIN_URL=http://localhost:3001
# Long random string: signs file links and OAuth state, encrypts integration tokens
APP_SECRET=
MOCK_MODE=true
LOG_LEVEL=info
# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# ---------- AI providers ----------
OPENAI_API_KEY=
# OPTIONAL — lets Admin → API usage show what OpenAI actually billed you (OpenAI has no "credit left" API).
#   1) Sign in at https://platform.openai.com as the organization Owner.
#   2) Settings (gear icon) → Organization → Admin keys → Create new admin key → copy it (starts with sk-admin-).
#   This is a DIFFERENT key from OPENAI_API_KEY above. Keep it private; it can read your organization's billing.
OPENAI_ADMIN_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_FALLBACK_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Distinct stock voices for extra speakers when they can't be cloned
ELEVENLABS_STOCK_VOICES=

# ---------------------------------------------------------------------
# NIGERIAN VOICES: SPITCH (native Yoruba, Hausa, Igbo and Pidgin voices)
# ---------------------------------------------------------------------
# Spitch is a Nigerian voice-AI company. Its voices are recorded from native speakers, so tones and names sound right,
# and it also restores Yoruba tone marks and translates into Yoruba, Hausa and Igbo. New accounts get $1 free credit.
#   1) Sign up at https://spitch.app (click "Get started" / "Sign up").
#   2) In the dashboard open "API keys" (or "Developers") -> "Create API key" -> copy it.
#   3) Paste it below and restart (npm run dev). Then open Admin -> Voice Lab to listen to every voice.
#   4) Add credit in the Spitch dashboard when the free $1 runs low (about $0.084 per minute of speech).
# Without this key, Yoruba/Hausa/Igbo/Pidgin are voiced by ElevenLabs instead.
SPITCH_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# openai (Whisper) or elevenlabs (Scribe; multi-speaker jobs always use Scribe)
TRANSCRIPTION_PROVIDER=openai
# Background music/effects separation: auto | demucs | elevenlabs | ffmpeg | none
SEPARATION_PROVIDER=auto
DEMUCS_COMMAND=demucs
# Faster Demucs settings (about 40% faster in our test, same quality for dubbing). On a computer with a graphics card (GPU) use: DEMUCS_ARGS=-d cuda
DEMUCS_ARGS=--overlap 0.1 -j 2
# Demucs takes about this many seconds of work for each second of video on a normal computer. Videos that would take longer than the
# limit below use a much faster method instead, so nobody waits hours. (Both can be changed in Admin → App settings.)
DEMUCS_SECONDS_PER_VIDEO_SECOND=2
SEPARATION_TIME_LIMIT_MINUTES=20
# Voice lines made at once. ElevenLabs allows 2 on the free plan, 3 on Starter, 5 on Creator, 10 on Pro.
ELEVENLABS_CONCURRENCY=2
# How hard the video encoder works: balanced, fast or fastest (fastest makes bigger files).
EXPORT_SPEED=fast
# Skip the slow background-music removal when the gaps between sentences are nearly silent (nothing to keep).
SKIP_QUIET_BACKGROUND=true
QUIET_BACKGROUND_DB=-40
# Only ask an AI which language each line is in when the creator chose "auto-detect" (set true to always ask).
DETECT_LANGUAGES_ALWAYS=false
# Show the dubbed video as soon as it is ready; captioned and resized copies keep rendering behind it.
DEFER_EXTRAS=true
# Use the native Nigerian voice when a cloned voice can't speak the language (or the plan can't clone).
NATIVE_VOICE_WHEN_CLONE_CANNOT_SPEAK=true
BACKGROUND_VOLUME=1

# ---------- Limits ----------
# Optional overrides for the free plan (otherwise the plans table decides)
FREE_MAX_VIDEO_MINUTES=
MAX_VIDEO_MINUTES=120
RETENTION_DAYS=30
MAX_REDUBS=5
# Times a customer can press Retry on one failed project (admins are never limited), and how long the admin audit log is kept.
MAX_RETRIES=3
# Spitch requests allowed at once (Spitch Tier 1 = 3). Also changeable in Admin → App settings.
SPITCH_CONCURRENCY=3
# Calm music offered while a video processes (all of this can be changed in Admin → App settings).
WAITING_MUSIC=true
AUDIT_RETENTION_DAYS=730

# ---------- Worker ----------
# inline = process jobs inside the API; off = run `npm run worker` separately
WORKER_MODE=inline
WORKER_CONCURRENCY=2

# ---------- Security ----------
RATE_LIMIT_PER_15_MIN=600
AUTH_RATE_LIMIT_PER_15_MIN=30
JOB_RATE_LIMIT_PER_HOUR=30
# Resumable uploads one person may start per hour, and new accounts one internet address may open per hour.
UPLOADS_PER_HOUR=40
SIGNUP_RATE_LIMIT_PER_HOUR=5
# Single-line re-translations allowed per project (each costs a little and uses no minutes).
MAX_RETRANSLATIONS=25
# Free dubbing needs a confirmed email address. Also turn on "Confirm email" in Supabase → Authentication → Providers → Email.
REQUIRE_CONFIRMED_EMAIL=true
# ClamAV clamd for upload virus scanning (docker compose --profile security up)
CLAMAV_HOST=
CLAMAV_PORT=3310
SENTRY_DSN=

# ---------- Import from link ----------
YTDLP_PATH=yt-dlp

# ---------- Notifications ----------
RESEND_API_KEY=
EMAIL_FROM=ReelLingo <notifications@yourdomain.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with two body variables: {{1}} message, {{2}} link
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------- Payments ----------
PAYSTACK_SECRET_KEY=
# Optional Paystack plan codes for automatic monthly renewal
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_CREATOR=
PAYSTACK_PLAN_STUDIO=
# Optional automatic renewal for the other plans and for yearly billing. Create each in Paystack -> Plans with these amounts:
#   Subtitles ₦4,500 monthly / ₦45,000 annually · Starter ₦15,000 / ₦150,000 · Creator ₦38,000 / ₦380,000
#   Studio ₦115,000 / ₦1,150,000 · Church & Ministry ₦225,000 / ₦2,250,000 (Interval: Monthly or Annually)
# If you leave a code empty, customers pay once per month (or year) by card, transfer or USSD instead.
PAYSTACK_PLAN_SUBTITLES=
PAYSTACK_PLAN_MINISTRY=
PAYSTACK_PLAN_SUBTITLES_YEARLY=
PAYSTACK_PLAN_STARTER_YEARLY=
PAYSTACK_PLAN_CREATOR_YEARLY=
PAYSTACK_PLAN_STUDIO_YEARLY=
PAYSTACK_PLAN_MINISTRY_YEARLY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe price IDs (otherwise prices come from the plans table)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=
# Optional: Stripe price IDs for the other plans and yearly billing (empty = ReelLingo creates the price at checkout).
STRIPE_PRICE_SUBTITLES=
STRIPE_PRICE_MINISTRY=
STRIPE_PRICE_SUBTITLES_YEARLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_MINISTRY_YEARLY=
NGN_PER_USD=1600

# ---------- Growth ----------
# Referral rewards: minutes for the inviter and the new customer, paid on the friend's first purchase that still makes you money.
REFERRAL_BONUS_MINUTES=3

# ---------- Lip-sync (sync.so) ----------
SYNC_API_KEY=
SYNC_MODEL=lipsync-2

# ---------- YouTube publishing (Google Cloud OAuth client) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Watermark / captions ----------
WATERMARK_TEXT=Made with ReelLingo
WATERMARK_FONT=
CAPTION_FONT=

# ---------------------------------------------------------------------
# PRICING SAFETY (all of these can also be changed in Admin -> App settings -> Pricing)
# ---------------------------------------------------------------------
# Free users together can never cost you more than this per month (US$). When reached, free dubbing pauses until the 1st.
FREE_MONTHLY_BUDGET_USD=20
# What ElevenLabs really costs YOU per 1,000 characters, from your ElevenLabs plan page (https://elevenlabs.io/app/subscription):
#   Creator plan overage ~0.30, Pro ~0.24, Scale ~0.18, pay-as-you-go API ~0.10. Used by Admin -> Profit check.
COST_ELEVENLABS_PER_1K_CHARS=0.24

# ---------------------------------------------------------------------
# HIDDEN FEATURES (switch on in Admin -> App settings -> Features when a customer asks)
# ---------------------------------------------------------------------
FEATURE_TEAMS=false
FEATURE_API=false

# ---------------------------------------------------------------------
# LEGAL PAGES (/terms and /privacy) - also editable in Admin -> App settings -> Legal
# ---------------------------------------------------------------------
# Your registered business name (as on your CAC certificate) and address.
LEGAL_COMPANY_NAME=ReelLingo
LEGAL_ADDRESS=Lagos, Nigeria
# Email for privacy requests under Nigeria's Data Protection Act (empty = SUPPORT email).
DPO_EMAIL=

REFERRAL_NEW_USER_MINUTES=1
